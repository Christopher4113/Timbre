# Neon pooled connection string (use the dev branch locally)
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, https://your-domain in prod
BETTER_AUTH_URL=
# Optional locally: magic links print to the server console without it
RESEND_API_KEY=
# Timbre <login@your-verified-domain.com>, or Timbre <onboarding@resend.dev> for testing
EMAIL_FROM=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# provider:model, e.g. anthropic:claude-opus-5-5 (the default when empty)
EXTRACT_MODEL=
GENERATE_MODEL=

# Local: INNGEST_DEV=1 and run `npx inngest-cli@latest dev`. Production: the two keys below.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
